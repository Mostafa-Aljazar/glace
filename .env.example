# Glace API base URL (must include /api)
# The backend is the single source of truth for home, events and menu data —
# there is no local fake-data mode.
NEXT_PUBLIC_API_URL=https://back.glaceelameer.com/api

# Public storefront URL — used for SEO metadata (canonical/OG links,
# sitemap.xml, robots.txt, JSON-LD). See src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://glaceelameer.com
